# Необязательные настройки сервера. Без них всё работает по умолчанию.
# Чтобы применить: скопируйте файл в apps/api/.env и перезапустите Канбат.

# Код входа для специалистов (если не задан — сервер придумает и покажет при запуске)
# SUPPORT_CODE=123456
# Код администратора организации (настройки помощника); нет — сервер придумает и покажет при запуске
# ADMIN_CODE=12345678

# Порт сервера
PORT=3000

# ——— ИИ ———
# По умолчанию — Ollama на этом компьютере.
# Ollama на другом компьютере: там OLLAMA_HOST=0.0.0.0, здесь OLLAMA_URL=http://<его адрес>:11434
OLLAMA_URL=http://127.0.0.1:11434
# Модель по умолчанию (если не выбрана в интерфейсе). Иначе: qwen3:8b → qwen3:14b → qwen2.5:7b → …
LLM_MODEL=qwen2.5:7b

# Облачный ИИ (любой сервис с OpenAI-совместимым API) — чтобы не зависеть от этого компьютера:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=ваш-ключ
# LLM_MODEL=gpt-4o-mini

# Сколько секунд ждать, пока модель начнёт отвечать (вместе с загрузкой в память; JSON — в 1,5 раза дольше).
# На медленном компьютере можно увеличить, например до 240.
# LLM_TIMEOUT_S=120

# Где хранить данные (по умолчанию apps/api/data)
# DATA_DIR=./data

# Ответы-заготовки вместо модели (только для разработки и тестов)
# LLM_DEMO=1
