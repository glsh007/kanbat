# Настройки Канбата на сервере. deploy/install.sh заполнит их сам;
# вручную — скопируйте в .env и заполните.

# ——— Адрес сайта (домен, A-запись которого указывает на IP сервера) ———
DOMAIN=kanbat.ru

# ——— Код входа для специалистов поддержки ———
SUPPORT_CODE=придумайте-код
# код администратора организации: настройки помощника (роль, тон, правила); не совпадает с кодом специалиста
ADMIN_CODE=придумайте-другой-код

# ——— ИИ: Qwen в Yandex AI Studio (рекомендуется) ———
LLM_PROVIDER=yandex
YANDEX_FOLDER_ID=
LLM_API_KEY=
# Модели через запятую: первая — по умолчанию, вторая — на выбор в «Настройках»
LLM_MODEL=qwen3.6-35b-a3b

# …или любой сервис с OpenAI-совместимым API:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# …или своя Ollama (закрытый контур; сервис ollama в docker-compose.yml):
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://ollama:11434
# LLM_MODEL=qwen2.5:7b

# Сколько секунд ждать, пока модель начнёт отвечать (JSON — в 1,5 раза дольше).
# LLM_TIMEOUT_S=120
# сроки хранения: вход без активности (дней) и переписка решённых заявок специалиста (дней)
SESSION_DAYS=30
TICKET_KEEP_DAYS=90
# сколько новых кабинетов можно зарегистрировать с одного адреса за 10 минут (защита от ботов)
REGISTER_LIMIT=20
# удалить аккаунт через столько дней без входа, если человек включил это в «Настройках» (ТЗ v4.18)
IDLE_DELETE_DAYS=365
# Бат-общение (ТЗ v4.19): закрыть переписку после N дней тишины / не позже M дней с начала
DM_QUIET_DAYS=3
DM_TOTAL_DAYS=7
